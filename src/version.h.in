// Single source of version number (generated by CMake configure_file; do not edit manually)
// Naming scheme: baseline Podradio_V0.1
//   - Fix line:   Podradio_V0.1-F01..-F99  (bug fixes, parallel)
//   - Y line:     Podradio_V0.1-Y01..-Y99  (multi-account / Google-login feature line, parallel to F)
// To change the version, edit PROJECT_VERSION and PODRADIO_FIX_SUFFIX at the top of CMakeLists.txt
#ifndef PODRADIO_VERSION_H
#define PODRADIO_VERSION_H

#define PODRADIO_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define PODRADIO_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define PODRADIO_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define PODRADIO_FIX_SUFFIX     "@PODRADIO_FIX_SUFFIX@"
#define PODRADIO_VERSION_STRING "@PODRADIO_FULL_VERSION@"

#endif // PODRADIO_VERSION_H
