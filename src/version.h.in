// Single source of version number (generated by CMake configure_file; do not edit manually)
// Naming scheme: baseline panicast_V0.1
//   - Fix line:   panicast_V0.1-F01..-F99  (bug fixes, parallel)
//   - Y line:     panicast_V0.1-Y01..-Y99  (multi-account / Google-login feature line, parallel to F)
// To change the version, edit PROJECT_VERSION and PANICAST_FIX_SUFFIX at the top of CMakeLists.txt
#ifndef PANICAST_VERSION_H
#define PANICAST_VERSION_H

#define PANICAST_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
#define PANICAST_VERSION_MINOR  @PROJECT_VERSION_MINOR@
#define PANICAST_VERSION_PATCH  @PROJECT_VERSION_PATCH@
#define PANICAST_FIX_SUFFIX     "@PANICAST_FIX_SUFFIX@"
#define PANICAST_VERSION_STRING "@PANICAST_FULL_VERSION@"

#endif // PANICAST_VERSION_H
