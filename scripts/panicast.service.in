# panicast — headless daemon mode (N10; formerly panicastd, N09/S1).
#   System-level unit (starts with the WSL distro / at boot on native Linux) running as
#   the INSTALL_USER with their HOME, so config/DB/logs land in the usual per-user paths.
#   One binary, two frontends: ExecStart runs `panicast -d` — the same engine as the TUI
#   with a NullFrontend; Squeezer (or the web remote) is the UI.
#   NOT enabled by default — the owner opts in explicitly: `sudo systemctl enable
#   panicast` (or `panicast enable`, which sudo-executes the same command).
#
#   Installed by build.sh with @INSTALL_USER@ / @INSTALL_HOME@ substituted.
[Unit]
Description=panicast headless media daemon (Squeezer remote control)
After=network.target sound.target
Wants=network.target

[Service]
Type=simple
User=@INSTALL_USER@
Environment=HOME=@INSTALL_HOME@
Environment=PULSE_SERVER=unix:/mnt/wslg/PulseServer
WorkingDirectory=@INSTALL_HOME@
ExecStart=/usr/local/bin/panicast -d
Restart=on-failure
RestartSec=3
# The daemon's clean shutdown (mpv stop joins) takes ~2-3s; give systemd ample headroom.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
