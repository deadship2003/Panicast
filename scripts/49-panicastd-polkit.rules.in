// polkit rule installed with panicastd (N09/S1): the owning user may start/stop/restart
//   the daemon unit WITHOUT a password — this powers `panicast start/stop/restart` and
//   the TUI↔daemon session handover (the TUI stops the daemon on launch and restarts it
//   on exit; neither moment has a terminal free for a sudo prompt). enable/disable are
//   deliberately NOT granted — autostart stays an explicit sudo action by the owner.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "panicastd.service" &&
        subject.isInGroup("@INSTALL_USER@")) {
        return polkit.Result.YES;
    }
});
